    { "id": "y010", "name": "陈勋", "gen": 2, "master": "y003", "era": "近代-当代", "primaryCuisine": "粤", "secondaryCuisines": [], "school": "guang-fu", "city": "广州", "restaurant": "北园酒家", "position": "粤点泰斗", "signature": ["玉液叉烧包", "虾饺", "干蒸烧卖"], "birth": 1924, "death": 2021, "source": "https://zh.wikipedia.org/zh-cn/%E9%99%B3%E5%8B%9B", "bio": "广东南海人，人称'勋叔'。14 岁入行师从崔强，被誉为粤点泰斗。粤点'四大天王'（虾饺、干蒸烧卖、叉烧包、蛋挞）提出者，与罗坤并称'西有罗坤，北有陈勋'。" },
    { "id": "y011", "name": "罗坤", "gen": 2, "master": null, "era": "近代-当代", "primaryCuisine": "粤", "secondaryCuisines": [], "school": "guang-fu", "city": "广州", "restaurant": "泮溪酒家", "position": "点心状元", "signature": ["玉液叉烧包", "象形点心", "生雪梨果"], "birth": 1930, "death": 2018, "source": "http://lbzyj.com/hdmr.asp?skey=120529887210", "bio": "广州著名点心师，泮溪酒家点心大师，曾任香港新光酒店点心师傅。与陈勋共同创制'玉液叉烧包'成为大同酒家招牌名点。开发系列象形点心，为粤式点心创新代表，'西有罗坤，北有陈勋'之'西'。" },
