/* 首页样式 */
.page { position: relative; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.home-scroll { flex: 1; position: relative; z-index: 2; }

/* ---------- 顶栏 ---------- */
.topbar {
  position: relative; z-index: 5;
  display: flex; align-items: center;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid var(--rule);
  background: rgba(237, 232, 219, .85);
}
.wm-stamp { width: 64rpx; height: 64rpx; font-size: 34rpx; }
.wm-text { margin-left: 18rpx; }
.wm-name { font-size: 32rpx; line-height: 1.1; }
.wm-sub { font-size: 14rpx; letter-spacing: .24em; color: var(--dust); }
.top-right {
  margin-left: auto;
  display: flex; align-items: center;
  font-size: 18rpx; letter-spacing: .1em; color: var(--ink-soft);
}
.top-right .pulse-dot { margin-right: 10rpx; }

/* ---------- Hero ---------- */
.hero { padding: 36rpx 32rpx 0; }
.hero-meta {
  display: flex; flex-wrap: wrap;
  border-top: 1rpx solid var(--rule-strong);
  border-bottom: 1rpx solid var(--rule);
}
.hm-item {
  width: 50%;
  padding: 18rpx 16rpx 18rpx 0;
  font-size: 24rpx; font-weight: 600;
  border-bottom: 1rpx solid var(--rule);
}
.hm-item:nth-child(-n+2) { border-bottom: 1rpx solid var(--rule); }
.hm-item:nth-child(n+3) { border-bottom: 0; }
.hm-sub { display: block; font-size: 20rpx; font-weight: 400; color: var(--dust); margin-top: 4rpx; }

.hero-main { position: relative; margin-top: 40rpx; }
.hero-h1 .line {
  font-size: 76rpx; line-height: 1.22; font-weight: 600;
  opacity: 0; transform: translateY(60rpx);
  transition: opacity .8s cubic-bezier(.2, .7, .2, 1), transform .8s cubic-bezier(.2, .7, .2, 1);
}
.hero-h1 .line.in { opacity: 1; transform: none; }
.hero-h1 .line.em { color: var(--vermillion); }

/* 环形钢印（绝对定位于标题右侧） */
.seal-tag {
  position: absolute; right: 8rpx; top: 24rpx;
  width: 168rpx; height: 168rpx;
}
.seal-ring {
  position: absolute; inset: 0;
  border: 2rpx solid var(--vermillion);
  border-radius: 50%;
  animation: xc-spin 32s linear infinite;
}
.seal-ring::after {
  content: ""; position: absolute; inset: 10rpx;
  border: 1rpx dashed rgba(184, 50, 26, .6);
  border-radius: 50%;
}
@keyframes xc-spin { to { transform: rotate(360deg); } }
.seal-inner {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: var(--vermillion);
}
.seal-y { font-size: 34rpx; line-height: 1.15; font-weight: 700; }
.seal-t { font-size: 12rpx; letter-spacing: .12em; margin-top: 6rpx; }

.hero-lead {
  margin-top: 44rpx;
  font-size: 32rpx; line-height: 1.8; font-weight: 500;
}
.b { font-weight: 700; }
.em-v { color: var(--vermillion); font-style: normal; }
.em-gold { color: var(--gold); font-style: normal; }
.mark { background: rgba(184, 50, 26, .14); padding: 0 8rpx; }
.hero-side {
  margin-top: 28rpx;
  padding-left: 28rpx;
  border-left: 4rpx solid var(--ink);
  font-size: 25rpx; line-height: 1.8; color: var(--ink-soft);
}
.hero-sign { margin-top: 32rpx; font-size: 40rpx; }
.sign-sub { font-size: 26rpx; color: var(--dust); margin-left: 12rpx; }
.hero-cta { display: flex; gap: 24rpx; margin-top: 40rpx; flex-wrap: wrap; }

/* ---------- 走马灯 ---------- */
.marquee {
  margin-top: 56rpx;
  border-top: 1rpx solid var(--ink);
  border-bottom: 1rpx solid var(--ink);
  overflow: hidden;
  padding: 18rpx 0;
}
.marquee-track { white-space: nowrap; animation: xc-marquee 36s linear infinite; display: inline-block; }
.mq-text { font-size: 34rpx; letter-spacing: .06em; }
@keyframes xc-marquee { to { transform: translateX(-50%); } }

/* ---------- 章节通用 ---------- */
.sec { padding: 72rpx 32rpx 0; }
.sec.dark {
  margin-top: 72rpx; padding: 64rpx 32rpx 64rpx;
  background: var(--ink); color: var(--paper);
}
.sec-head { position: relative; padding-bottom: 28rpx; }
.sec-num { font-size: 20rpx; letter-spacing: .2em; color: var(--vermillion); }
.sec-h2 { font-size: 56rpx; line-height: 1.3; margin-top: 12rpx; }
.sec.dark .sec-h2 { color: var(--paper); }
.sec-right { margin-top: 14rpx; font-size: 20rpx; color: var(--dust); line-height: 1.7; }

/* ---------- §01 问题 ---------- */
.prob-label { border-left: 4rpx solid var(--vermillion); padding-left: 28rpx; margin-bottom: 32rpx; }
.prob-big { font-size: 44rpx; line-height: 1.4; }
.prob-note { margin-top: 10rpx; font-size: 24rpx; color: var(--dust); }
.prob-text .p { font-size: 27rpx; line-height: 1.9; margin-bottom: 24rpx; color: var(--ink-soft); }
.pull {
  margin: 36rpx 0;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--rule-strong);
  border-bottom: 1rpx solid var(--rule-strong);
  font-size: 36rpx; line-height: 1.6; color: var(--ink);
}

/* ---------- §01.5 故事 ---------- */
.story-card {
  background: var(--ink); color: var(--paper);
  padding: 40rpx 36rpx;
  box-shadow: 16rpx 16rpx 0 var(--vermillion);
}
.story-meta { font-size: 18rpx; letter-spacing: .1em; color: var(--dust); }
.story-h3 { font-size: 42rpx; line-height: 1.5; margin-top: 24rpx; }
.story-quote {
  margin-top: 24rpx; padding-left: 24rpx;
  border-left: 4rpx solid var(--vermillion);
  font-size: 25rpx; line-height: 1.8; color: var(--paper-3);
}
.story-p { margin-top: 20rpx; font-size: 25rpx; line-height: 1.85; color: var(--paper-2); }
.story-tags { display: flex; flex-wrap: wrap; margin-top: 28rpx; }
.story-tag {
  font-size: 20rpx; color: var(--gold);
  border: 1rpx solid var(--gold);
  padding: 6rpx 18rpx; margin: 0 14rpx 14rpx 0;
}
.story-stats { margin-top: 40rpx; }
.ss-item {
  padding: 28rpx 0;
  border-top: 1rpx solid var(--rule);
}
.ss-n { font-size: 64rpx; color: var(--vermillion); }
.ss-label { font-size: 26rpx; font-weight: 600; margin-top: 6rpx; }
.ss-desc { font-size: 23rpx; color: var(--ink-soft); line-height: 1.75; margin-top: 8rpx; }

/* ---------- §02 能力索引 ---------- */
.ix-item {
  display: flex; align-items: center;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--rule);
}
.ix-num { flex: none; width: 110rpx; font-size: 18rpx; color: var(--dust); letter-spacing: .08em; }
.ix-body { flex: 1; min-width: 0; }
.ix-name { font-size: 36rpx; }
.ix-tag {
  font-size: 18rpx; color: var(--paper); background: var(--vermillion);
  padding: 3rpx 14rpx; margin-left: 14rpx; vertical-align: 6rpx;
}
.ix-desc { font-size: 22rpx; color: var(--ink-soft); line-height: 1.7; margin-top: 8rpx; }
.ix-meta { flex: none; font-size: 17rpx; color: var(--dust); margin: 0 18rpx; letter-spacing: .06em; }
.ix-go { flex: none; font-size: 34rpx; color: var(--vermillion); }

/* ---------- §03 双支柱 ---------- */
.pillar {
  border: 1rpx solid var(--rule-strong);
  background: rgba(255, 255, 255, .3);
  padding: 36rpx;
  margin-bottom: 28rpx;
}
.pl-num { font-size: 18rpx; letter-spacing: .16em; color: var(--vermillion); }
.pl-h3 { font-size: 52rpx; margin-top: 16rpx; }
.pl-p { font-size: 25rpx; line-height: 1.85; color: var(--ink-soft); margin-top: 18rpx; }
.pl-li {
  font-size: 25rpx; padding: 14rpx 0 14rpx 32rpx;
  border-top: 1rpx solid var(--rule);
  position: relative;
}
.pl-li::before {
  content: ""; position: absolute; left: 4rpx; top: 26rpx;
  width: 10rpx; height: 10rpx; background: var(--vermillion);
}
.pl-btn { margin-top: 24rpx; }

/* ---------- §04 流程 ---------- */
.steps { display: flex; flex-wrap: wrap; }
.step {
  width: calc(50% - 12rpx);
  margin: 0 24rpx 24rpx 0;
  border: 1rpx solid var(--rule);
  padding: 28rpx;
  background: rgba(255, 255, 255, .25);
}
.step:nth-child(2n) { margin-right: 0; }
.st-n { font-size: 40rpx; color: var(--vermillion); font-style: italic; }
.st-t { font-size: 36rpx; margin-top: 8rpx; }
.st-d { font-size: 22rpx; line-height: 1.7; color: var(--ink-soft); margin-top: 12rpx; }
.st-dur {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 18rpx; letter-spacing: .1em;
  border: 1rpx solid var(--rule-strong);
  padding: 4rpx 16rpx; color: var(--ink-soft);
}

/* ---------- §05 社会价值（黑底） ---------- */
.sec.dark .sec-right { color: var(--dust); }
.stats-grid { display: flex; flex-wrap: wrap; }
.sg-item { width: 50%; padding: 28rpx 20rpx 28rpx 0; border-top: 1rpx solid rgba(237, 232, 219, .2); }
.sg-n { font-size: 68rpx; color: var(--paper); }
.sg-u { font-size: 32rpx; color: var(--gold); margin-left: 6rpx; }
.sg-label { font-size: 25rpx; font-weight: 600; margin-top: 8rpx; }
.sg-note { font-size: 21rpx; color: var(--dust); line-height: 1.7; margin-top: 8rpx; }

/* ---------- §05.5 飞轮 ---------- */
.fw-wrap { display: flex; justify-content: center; }
.fw-canvas { width: 640rpx; height: 640rpx; }
.fw-list { margin-top: 24rpx; }
.fw-row { display: flex; padding: 26rpx 0; border-top: 1rpx solid var(--rule); }
.fw-num { flex: none; width: 72rpx; font-size: 40rpx; font-style: italic; color: var(--vermillion); }
.fw-body { flex: 1; }
.fw-t { font-size: 32rpx; }
.fw-d { font-size: 23rpx; line-height: 1.75; color: var(--ink-soft); margin-top: 8rpx; }
.rev-row { margin-top: 24rpx; }
.rev {
  border: 1rpx solid var(--rule-strong);
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, .3);
}
.rev-tag { font-size: 17rpx; letter-spacing: .16em; color: var(--gold); }
.rev-t { font-size: 34rpx; margin-top: 10rpx; }
.rev-d { font-size: 22rpx; line-height: 1.75; color: var(--ink-soft); margin-top: 10rpx; }

/* ---------- §06 CTA ---------- */
.cta-sec { padding: 96rpx 32rpx 80rpx; text-align: center; }
.cta-small { font-size: 19rpx; letter-spacing: .2em; color: var(--dust); }
.cta-big { font-size: 60rpx; line-height: 1.5; margin-top: 24rpx; }
.cta-actions { display: flex; justify-content: center; gap: 24rpx; margin-top: 48rpx; flex-wrap: wrap; }

/* ---------- 页脚 ---------- */
.footer {
  border-top: 1rpx solid var(--rule-strong);
  padding: 40rpx 32rpx 0;
  text-align: center;
}
.ft-brand { font-size: 36rpx; }
.ft-note { font-size: 20rpx; color: var(--dust); margin-top: 12rpx; line-height: 1.7; }
.ft-safe { height: 40rpx; }
